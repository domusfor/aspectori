# Canonical site URL, used for share images. On Vercel this falls back to the production domain.
NEXT_PUBLIC_SITE_URL=https://example.com

# Required public-release identity and privacy configuration.
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTACT_EMAIL=
PRIVACY_LEGAL_BASIS=
PRIVACY_HOSTING_PROVIDER=Vercel
PRIVACY_GEOCODER_PROVIDER=
PRIVACY_LOG_RETENTION=
PRIVACY_TRANSFER_INFO=

# City lookup. Defaults to Open-Meteo's free geocoder, which is for non-commercial use only.
# For launch, use a paid Open-Meteo plan (customer-geocoding-api.open-meteo.com) or self-host GeoNames.
GEOCODER_URL=
GEOCODER_API_KEY=

# Choose "commercial" after buying the Astrodienst license, or "agpl" and publish
# the complete corresponding source at NEXT_PUBLIC_SOURCE_URL.
SWISS_EPHEMERIS_LICENSE_MODE=
NEXT_PUBLIC_SOURCE_URL=

# Set only after the production edge/firewall rule for /api/* has been tested.
EDGE_RATE_LIMIT_CONFIRMED=false

# PDF reports are free and enabled for everyone. No payment configuration is needed.

# Search engine ownership verification (Google Search Console, Bing Webmaster Tools).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
