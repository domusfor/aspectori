# Canonical site URL, used for share images. On Vercel this falls back to the production domain.
NEXT_PUBLIC_SITE_URL=https://aspectori.com

# Required public-release identity and privacy configuration.
PRIVACY_CONTROLLER_NAME=Aspectori
PRIVACY_CONTACT_EMAIL=support@karai.bg
PRIVACY_LEGAL_BASIS=Article 6(1)(f) GDPR: legitimate interests in providing the requested service, maintaining reliability, and preventing abuse; consent where specifically requested.
PRIVACY_HOSTING_PROVIDER=Vercel
PRIVACY_GEOCODER_PROVIDER=Open-Meteo open-access geocoding API
PRIVACY_LOG_RETENTION=
PRIVACY_TRANSFER_INFO=

# City lookup. Aspectori is free, open source, ad-free and noncommercial, so it
# uses Open-Meteo's open-access endpoint within its published usage limits.
GEOCODER_URL=https://geocoding-api.open-meteo.com/v1/search
GEOCODER_API_KEY=
GEOCODER_USE_MODE=noncommercial

# Aspectori and its complete corresponding source are published under AGPL-3.0-or-later.
SWISS_EPHEMERIS_LICENSE_MODE=agpl
SWISS_EPHEMERIS_COMMERCIAL_LICENSE_CONFIRMED=false
NEXT_PUBLIC_SOURCE_URL=https://github.com/domusfor/aspectori

# Set only after the production edge/firewall rule for /api/* has been tested.
EDGE_RATE_LIMIT_CONFIRMED=false

# PDF reports are free and enabled for everyone. No payment configuration is needed.

# Optional at launch. Add these after the domain is verified in each webmaster tool.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
