    "release:check": "node scripts/validate-release.mjs",
    "data:import": "tsx scripts/import-famous.ts && tsx --conditions=react-server scripts/build-summaries.ts",
    "data:audit": "tsx scripts/audit-famous-data.ts",
    "data:summaries": "tsx --conditions=react-server scripts/build-summaries.ts"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "luxon": "^3.7.2",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sweph": "^2.10.3-8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/luxon": "^3.7.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
